# GitHub Personal Access Token (PAT) for checking candidate GitHub profiles.
# Grants 5,000 requests/hour rate limit and unlocks analysis of up to 8+ repositories.
# A standard read-only or classic PAT with NO special scopes needed (public data only).
GITHUB_TOKEN=your_github_token_here

# Ollama Model for inference evaluation (default: huihui_ai/qwen3.5-abliterated:9b)
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:9b
